# Public site — no env vars required for v1.

# Recommended when using a custom domain on Vercel:
# NEXT_PUBLIC_SITE_URL=https://getyourproductbuilt.com

# Case study Loom walkthroughs (paste share URLs after recording):
# NEXT_PUBLIC_LOOM_INBOX=https://www.loom.com/share/...
# NEXT_PUBLIC_LOOM_LEAD_QUALIFIER=https://www.loom.com/share/...
# NEXT_PUBLIC_LOOM_WEEKLY_REPORT=https://www.loom.com/share/...

# Internal marketing dashboard (/tools/marketing) — local dev example:
# MARKETING_DASHBOARD_SECRET=choose-a-long-password-only-you-know
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# MARKETING_GOOGLE_CLIENT_ID=...
# MARKETING_GOOGLE_CLIENT_SECRET=...
# Google OAuth redirect auto-derives as {NEXT_PUBLIC_SITE_URL}/api/marketing/google/callback
